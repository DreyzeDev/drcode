#!/usr/bin/env bash
# DRCODE_LAUNCHER=1

set -Eeuo pipefail

readonly DRCODE_HOME="${DRCODE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/drcode}"
readonly DRCODE_CONFIG_HOME="${DRCODE_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/drcode}"
readonly DRCODE_ENGINE="${DRCODE_ENGINE:-$DRCODE_HOME/bin/opencode}"
readonly DRCODE_OPENCODE_CONFIG="$DRCODE_CONFIG_HOME/opencode"
readonly DRCODE_INSTALL_URL="${DRCODE_INSTALL_URL:-https://raw.githubusercontent.com/DreyzeDev/drcode/main/install.sh}"
readonly DRCODE_UNINSTALL_URL="${DRCODE_UNINSTALL_URL:-https://raw.githubusercontent.com/DreyzeDev/drcode/main/uninstall.sh}"
readonly DRCODE_REPOSITORY_REF="${DRCODE_REPOSITORY_REF:-main}"

fail() {
  printf 'DrCode: %s\n' "$*" >&2
  exit 1
}

doctor() {
  local failed=0

  printf 'DrCode diagnostics\n\n'
  if [[ -x "$DRCODE_ENGINE" ]]; then
    printf '  [ok] engine: %s\n' "$DRCODE_ENGINE"
    printf '       %s\n' "$("$DRCODE_ENGINE" --version 2>/dev/null || printf 'version unavailable')"
  else
    printf '  [!!] engine not found: %s\n' "$DRCODE_ENGINE"
    failed=1
  fi

  for file in opencode.json cli.json AGENTS.md; do
    if [[ -s "$DRCODE_OPENCODE_CONFIG/$file" ]]; then
      printf '  [ok] config: %s\n' "$file"
    else
      printf '  [!!] config missing: %s\n' "$DRCODE_OPENCODE_CONFIG/$file"
      failed=1
    fi
  done

  printf '  [ok] credentials: managed locally through /connect\n'

  return "$failed"
}

run_remote_script() {
  local url="$1"
  local repository_path="$2"
  shift 2

  local temporary
  temporary="$(mktemp "${TMPDIR:-/tmp}/drcode-script.XXXXXX")"
  trap 'rm -f "$temporary"' RETURN

  if command -v curl >/dev/null 2>&1 && curl --proto '=https' --tlsv1.2 -fsSL --retry 3 "$url" -o "$temporary" 2>/dev/null; then
    :
  elif command -v gh >/dev/null 2>&1 && gh api \
    --header 'Accept: application/vnd.github.raw+json' \
    "repos/DreyzeDev/drcode/contents/$repository_path?ref=$DRCODE_REPOSITORY_REF" >"$temporary"; then
    :
  else
    fail "не удалось получить $repository_path из приватного репозитория; выполните вход через gh auth login"
  fi

  bash "$temporary" "$@"
  rm -f "$temporary"
  trap - RETURN
}

resolve_model() {
  case "$1" in
    sol | gpt-6.1-sol)
      printf '%s\n' 'agentrouter/gpt-6.1-sol'
      ;;
    astra | gpt-6-astra)
      printf '%s\n' 'agentrouter/gpt-6-astra'
      ;;
    gpt5 | gpt-5.6-sol)
      printf '%s\n' 'agentrouter/gpt-5.6-sol'
      ;;
    oxion-sol)
      printf '%s\n' 'oxionai/gpt-5.6-sol'
      ;;
    oxion-astra)
      printf '%s\n' 'oxionai/gpt-5.5-pro'
      ;;
    oxion-gpt5)
      printf '%s\n' 'oxionai/gpt-5.5'
      ;;
    oxion-opus)
      printf '%s\n' 'oxionai/claude-opus-5.5'
      ;;
    */*)
      printf '%s\n' "$1"
      ;;
    *)
      printf 'agentrouter/%s\n' "$1"
      ;;
  esac
}

case "${1:-}" in
  doctor)
    doctor
    exit $?
    ;;
  self-update)
    shift
    run_remote_script "$DRCODE_INSTALL_URL" "install.sh" "$@"
    exit 0
    ;;
  self-uninstall)
    shift
    if [[ -f "$DRCODE_HOME/uninstall.sh" ]]; then
      exec bash "$DRCODE_HOME/uninstall.sh" "$@"
    fi
    run_remote_script "$DRCODE_UNINSTALL_URL" "uninstall.sh" "$@"
    exit 0
    ;;
esac

[[ -x "$DRCODE_ENGINE" ]] || fail "движок не найден; переустановите DrCode"

mkdir -p "$DRCODE_HOME/data"
chmod 700 "$DRCODE_HOME" "$DRCODE_HOME/data"
export OPENCODE_CLIENT="drcode"
export OPENCODE_CONFIG_DIR="$DRCODE_OPENCODE_CONFIG"
export OPENCODE_DB="$DRCODE_HOME/data/drcode.db"

arguments=()
while (($#)); do
  case "$1" in
    -m | --model)
      (($# >= 2)) || fail "после $1 требуется название модели"
      arguments+=("$1" "$(resolve_model "$2")")
      shift 2
      ;;
    --model=*)
      arguments+=("--model=$(resolve_model "${1#*=}")")
      shift
      ;;
    *)
      arguments+=("$1")
      shift
      ;;
  esac
done

# A private server keeps DrCode configuration and credentials independent from
# another OpenCode installation. Explicit server options always take priority.
standalone=true
for argument in "${arguments[@]}"; do
  case "$argument" in
    --standalone | --server | --server=*)
      standalone=false
      break
      ;;
  esac
done

case "${arguments[0]:-}" in
  acp | auth | debug | mcp | pair | plugin | serve | service | session | uninstall | update | upgrade)
    standalone=false
    ;;
esac

if "$standalone"; then
  case "${arguments[0]:-}" in
    api | mini | models | run | stats)
      exec "$DRCODE_ENGINE" "${arguments[0]}" --standalone "${arguments[@]:1}"
      ;;
  esac
  exec "$DRCODE_ENGINE" --standalone "${arguments[@]}"
fi
exec "$DRCODE_ENGINE" "${arguments[@]}"
